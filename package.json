{
  "name": "@red-cup-engineering/github-software-induction-service",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "Customer-side verification and atomic GitHub induction of supplier software proposals.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/github-software-induction-service.git"
  },
  "bin": {
    "execute-github-software-induction-a2a-message": "./scripts/execute-a2a-message.mjs",
    "submit-github-software-induction-activitypub": "./scripts/submit-activitypub.mjs",
    "serve-github-software-induction-a2a": "./scripts/serve-a2a.mjs"
  },
  "exports": {
    ".": "./src/client.mjs",
    "./executor": "./src/a2a-executor.mjs",
    "./src/client.mjs": "./src/client.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "workspace:*",
    "@red-cup-engineering/a2a-rmn-part-service": "workspace:*",
    "@red-cup-engineering/a2a-rmn-task-client-service": "workspace:*",
    "@red-cup-engineering/activitypub-services-section": "workspace:*",
    "@red-cup-engineering/github-services-section": "workspace:*",
    "@red-cup-engineering/gcloud-runtime-authorities-service": "workspace:*",
    "@red-cup-engineering/immutable-content-custody-service": "workspace:*",
    "@red-cup-engineering/computer-content-address-engineering-services-section": "workspace:*"
  },
  "scripts": {
    "check": "node --check src/a2a-executor.mjs && node --check src/client.mjs && node --check src/github-induction-production-runtime.mjs && node --check src/serve-activitypub.mjs && node --check scripts/execute-a2a-message.mjs && node --check scripts/submit-activitypub.mjs && node --check scripts/serve-a2a.mjs",
    "test": "node --test"
  },
